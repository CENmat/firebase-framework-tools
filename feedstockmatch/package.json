{
  "name": "feedstockmatch",
  "version": "1.0.0-mvp",
  "description": "Circular bioeconomy matching platform — connects organic byproduct suppliers with processors, with transparent LCA impact estimates",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r public dist/public",
    "start": "node dist/server.js",
    "test": "mocha --require tsx 'tests/**/*.spec.ts'",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "tsx": "^4.7.0",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "mocha": "^10.2.0",
    "@types/mocha": "^10.0.6"
  }
}
